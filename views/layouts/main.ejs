<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0c0c0d">
  <title><%= title %></title>
  <script>document.documentElement.classList.add('js')</script>
  <link rel="preload" href="/fonts/big-shoulders-display-latin-900-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/instrument-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preconnect" href="https://images.unsplash.com">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="wipe" aria-hidden="true"><span></span><span></span></div>

  <header class="nav">
    <a href="/" class="brand" aria-label="DebateBot home">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-word">Debate<b>Bot</b></span>
    </a>
    <nav class="nav-links">
      <a href="/#motions" class="nav-link">Motions</a>
      <a href="/#format" class="nav-link">Format</a>
      <a href="/#motions" class="nav-btn">Take the floor</a>
    </nav>
  </header>

  <main><%- body %></main>

  <footer class="foot">
    <div class="foot-giant" aria-hidden="true">DEBATEBOT</div>
    <div class="foot-row">
      <span>Every argument grounded in evidence.</span>
      <span>Groq &middot; RAG &middot; Six rounds</span>
      <span>Photography via Unsplash</span>
    </div>
  </footer>

  <script src="/js/app.js"></script>
</body>
</html>
