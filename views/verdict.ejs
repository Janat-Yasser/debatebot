<% if (verdict) {
  const sf = Number(verdict.score_for) || 0;
  const sa = Number(verdict.score_against) || 0;
  const share = (sf + sa) > 0 ? Math.round(sf / (sf + sa) * 1000) / 10 : 50;
  const youWon = verdict.winner === session.userSide;
%>
<div class="verdict win-<%= verdict.winner %>">

  <section class="v-hero">
    <div class="v-hero-photo" aria-hidden="true"></div>
    <div class="v-hero-inner">
      <p class="kicker" data-reveal>The House has divided</p>
      <p class="v-motion" data-reveal><%= topic.title %></p>
      <% if (verdict.winner === 'draw') { %>
        <p class="v-label" data-reveal>Result</p>
        <h1 class="v-winner" data-split>A dead heat.</h1>
        <p class="v-tag" data-reveal>Both benches argued equally well.</p>
      <% } else { %>
        <p class="v-label" data-reveal>Motion carried by</p>
        <h1 class="v-winner" data-split><%= verdict.winner_label %></h1>
        <p class="v-tag" data-reveal><%= youWon ? 'That was you. Well argued.' : 'The AI takes this one. Rematch?' %></p>
      <% } %>
    </div>
  </section>

  <section class="v-score" data-reveal>
    <div class="v-side v-side-for">
      <span class="v-side-label"><%= topic.for_label %><%= session.userSide === 'for' ? ' (you)' : '' %></span>
      <span class="v-num" data-count="<%= sf %>"><%= sf %></span>
    </div>
    <div class="tug" style="--share:<%= share %>%">
      <span class="tug-for"></span>
      <span class="tug-mid" aria-hidden="true"></span>
    </div>
    <div class="v-side v-side-against">
      <span class="v-side-label"><%= topic.against_label %><%= session.userSide === 'against' ? ' (you)' : '' %></span>
      <span class="v-num" data-count="<%= sa %>"><%= sa %></span>
    </div>
  </section>

  <section class="v-body">
    <div class="v-quote" data-reveal>
      <p class="kicker">From the judge</p>
      <blockquote><%= verdict.summary %></blockquote>
    </div>

    <div class="v-notes">
      <div class="v-note" data-reveal>
        <p class="kicker">Turning point</p>
        <p><%= verdict.key_moment %></p>
      </div>
      <div class="v-note" data-reveal>
        <p class="kicker">Take this with you</p>
        <p><%= verdict.lesson %></p>
      </div>
    </div>

    <div class="v-strengths">
      <div class="v-col v-col-for" data-reveal>
        <h3><%= topic.for_label %></h3>
        <ul>
          <% (verdict.for_strengths || []).forEach(s => { %><li><%= s %></li><% }) %>
        </ul>
      </div>
      <div class="v-col v-col-against" data-reveal>
        <h3><%= topic.against_label %></h3>
        <ul>
          <% (verdict.against_strengths || []).forEach(s => { %><li><%= s %></li><% }) %>
        </ul>
      </div>
    </div>

    <div class="v-actions" data-reveal>
      <a href="/topic/<%= topic.id %>" class="btn btn-verdict" data-magnetic>Rematch <span aria-hidden="true">&#8635;</span></a>
      <a href="/" class="btn btn-ghost">New motion</a>
    </div>
  </section>
</div>
<% } else { %>
<div class="verdict">
  <section class="v-hero v-hero-empty">
    <div class="v-hero-inner">
      <p class="kicker">No verdict</p>
      <h1 class="v-winner" data-split>Not enough on the record.</h1>
      <p class="v-tag">The debate needs at least one exchange before the judge can rule.</p>
      <div class="v-actions">
        <a href="/topic/<%= topic.id %>" class="btn btn-verdict">Back to the motion</a>
        <a href="/" class="btn btn-ghost">All motions</a>
      </div>
    </div>
  </section>
</div>
<% } %>
