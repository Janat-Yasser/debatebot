<% const keyProblem = message && message.includes('API'); %>
<section class="err">
  <p class="kicker">Point of order</p>
  <h1 class="err-title" data-split>Order, order.</h1>
  <p class="err-msg" data-reveal><%= keyProblem ? 'The debate engine isn\'t set up yet. Please contact the administrator to add a Groq key.' : message %></p>
  <a href="/" class="btn btn-verdict" data-reveal>Back to the chamber <span aria-hidden="true">&rarr;</span></a>
</section>
