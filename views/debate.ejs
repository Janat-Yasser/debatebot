<%
  const label = s => s === 'for' ? topic.for_label : topic.against_label;
  const roundOf = i => i === 0 ? 'Opening' : 'Round ' + Math.ceil(i / 2);
%>
<div class="debate" data-user="<%= session.userSide %>" data-ai="<%= session.aiSide %>">

  <header class="d-top">
    <a href="/topic/<%= topic.id %>" class="back-link"><span aria-hidden="true">&larr;</span> Leave</a>
    <div class="d-motion"><span class="kicker">Motion</span><span class="d-motion-title"><%= topic.title %></span></div>
    <div class="d-rounds">
      <div class="round-tracker" aria-hidden="true">
        <% for (let i = 1; i <= session.maxRounds; i++) { %>
          <span class="round-dot <%= i <= session.round ? 'done' : i === session.round + 1 ? 'current' : '' %>"><%= i %></span>
        <% } %>
      </div>
      <span class="round-label">Round <b id="currentRound"><%= session.round %></b>/<%= session.maxRounds %></span>
    </div>
  </header>

  <div class="benches">
    <div class="bench-chip chip-<%= session.userSide %>">
      <span class="chip-dot"></span>
      <span class="chip-who">You</span>
      <span class="chip-side"><%= label(session.userSide) %></span>
    </div>
    <span class="benches-vs">vs</span>
    <div class="bench-chip chip-<%= session.aiSide %> chip-right">
      <span class="chip-side"><%= label(session.aiSide) %></span>
      <span class="chip-who">AI</span>
      <span class="chip-dot"></span>
    </div>
  </div>

  <div class="chamber" id="debateChamber">
    <div class="chamber-inner" id="chamberInner">
      <% messages.forEach((msg, i) => { %>
        <article class="msg msg-<%= msg.role %> msg-<%= msg.side %>">
          <header class="msg-head">
            <span class="msg-who"><%= msg.role === 'user' ? 'You' : 'AI opponent' %></span>
            <span class="msg-side"><%= label(msg.side) %></span>
            <span class="msg-round"><%= roundOf(i) %></span>
          </header>
          <div class="msg-text"><%= msg.content %></div>
        </article>
      <% }) %>

      <div class="msg msg-ai msg-<%= session.aiSide %> msg-typing" id="typingIndicator" hidden>
        <header class="msg-head">
          <span class="msg-who">AI opponent</span>
          <span class="msg-side"><%= label(session.aiSide) %></span>
        </header>
        <div class="wave wave-sm" aria-label="AI is responding"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
      </div>
    </div>
  </div>

  <% if (!isOver) { %>
  <div class="dock" id="inputWrap">
    <div class="dock-inner">
      <label class="dock-label" for="argumentInput">Your rebuttal &middot; round <span id="inputRound"><%= session.round + 1 %></span></label>
      <textarea maxlength="2000"
        id="argumentInput"
        class="dock-input"
        placeholder="Make your case. Be specific, cite evidence, go after their weakest point."
        rows="3"
        maxlength="1500"
      ></textarea>
      <div class="dock-bar">
        <span class="meter" aria-hidden="true"><i id="charMeter"></i></span>
        <span class="char-count"><span id="charCount">0</span>/1500</span>
        <span class="kbd">Ctrl + Enter</span>
        <button id="submitBtn" class="btn btn-argue" type="button" data-magnetic>
          <span class="btn-label">Argue</span>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2"/></svg>
        </button>
      </div>
    </div>
  </div>
  <% } else { %>
  <div class="over">
    <p class="kicker">The floor is closed</p>
    <h2>All rounds are done.</h2>
    <a href="/verdict/<%= session.id %>" class="btn btn-verdict" data-magnetic>Hear the verdict <span aria-hidden="true">&rarr;</span></a>
  </div>
  <% } %>
</div>

<script>
  const SESSION_ID = <%- JSON.stringify(session.id) %>;
  const TOPIC_ID = <%- JSON.stringify(topic.id) %>;
  const AI_SIDE = <%- JSON.stringify(session.aiSide) %>;
  const USER_SIDE = <%- JSON.stringify(session.userSide) %>;
  const FOR_LABEL = <%- JSON.stringify(topic.for_label) %>;
  const AGAINST_LABEL = <%- JSON.stringify(topic.against_label) %>;
  const MAX_ROUNDS = <%= session.maxRounds %>;
</script>
<script src="/js/debate.js"></script>
