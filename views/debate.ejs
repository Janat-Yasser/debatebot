<div class="debate-page">

  <div class="debate-header">
    <div class="debate-header-left">
      <a href="/topic/<%= topic.id %>" class="back-link">&larr; Back</a>
      <div class="debate-topic-label"><%= topic.title %></div>
    </div>
    <div class="round-tracker">
      <% for(let i = 1; i <= session.maxRounds; i++) { %>
        <div class="round-dot <%= i <= session.round ? 'done' : i === session.round + 1 ? 'current' : '' %>">
          <%= i %>
        </div>
      <% } %>
    </div>
    <div class="debate-header-right">
      <span class="round-label">Round <span id="currentRound"><%= session.round %></span> / <%= session.maxRounds %></span>
    </div>
  </div>

  <div class="combatants-bar">
    <div class="combatant combatant-you">
      <div class="combatant-icon you-icon">YOU</div>
      <div class="combatant-info">
        <span class="combatant-label">Your Position</span>
        <span class="combatant-side"><%= session.userSide === 'for' ? topic.for_label : topic.against_label %></span>
      </div>
    </div>
    <div class="combatant-vs">vs</div>
    <div class="combatant combatant-ai">
      <div class="combatant-info" style="text-align:right">
        <span class="combatant-label">AI Opponent</span>
        <span class="combatant-side"><%= session.aiSide === 'for' ? topic.for_label : topic.against_label %></span>
      </div>
      <div class="combatant-icon ai-icon">AI</div>
    </div>
  </div>

  <div class="debate-chamber" id="debateChamber">
    <% messages.forEach(msg => { %>
      <div class="message message-<%= msg.role %> message-<%= msg.side %>">
        <div class="message-avatar <%= msg.role === 'user' ? 'avatar-you' : 'avatar-ai' %>">
          <%= msg.role === 'user' ? 'YOU' : 'AI' %>
        </div>
        <div class="message-body">
          <div class="message-header">
            <span class="message-from"><%= msg.role === 'user' ? 'You' : 'AI Opponent' %></span>
            <span class="message-stance stance-<%= msg.side %>">
              <%= msg.side === 'for' ? topic.for_label : topic.against_label %>
            </span>
          </div>
          <div class="message-content"><%= msg.content %></div>
        </div>
      </div>
    <% }) %>

    <div class="message message-ai" id="typingIndicator" style="display:none">
      <div class="message-avatar avatar-ai">AI</div>
      <div class="message-body">
        <div class="message-header">
          <span class="message-from">AI Opponent</span>
          <span class="message-stance stance-<%= session.aiSide %>">
            <%= session.aiSide === 'for' ? topic.for_label : topic.against_label %>
          </span>
        </div>
        <div class="typing-dots">
          <span></span><span></span><span></span>
        </div>
      </div>
    </div>
  </div>

  <div class="argument-input-wrap" id="inputWrap">
    <div class="argument-input-header">
      <span class="input-label">Your Argument &mdash; Round <span id="inputRound"><%= session.round + 1 %></span></span>
      <span class="input-hint">Ctrl + Enter to submit</span>
    </div>
    <div class="argument-input-body">
      <textarea
        id="argumentInput"
        class="argument-textarea"
        placeholder="Make your case here. Be specific, cite evidence, challenge the AI's points directly."
        rows="4"
        maxlength="1500"
      ></textarea>
      <div class="input-footer">
        <span class="char-count"><span id="charCount">0</span> / 1500</span>
        <button id="submitBtn" class="btn-argue" onclick="submitArgument()">Argue</button>
      </div>
    </div>
  </div>

  <% if (isOver) { %>
    <div class="debate-over-banner">
      <h2>Debate Complete</h2>
      <p>All rounds have been fought. Time for the judge's verdict.</p>
      <a href="/verdict/<%= session.id %>" class="btn-verdict">See the Verdict &rarr;</a>
    </div>
  <% } %>
</div>

<script>
  const SESSION_ID = '<%= session.id %>';
  const TOPIC_ID = '<%= topic.id %>';
  const AI_SIDE = '<%= session.aiSide %>';
  const USER_SIDE = '<%= session.userSide %>';
  const FOR_LABEL = '<%= topic.for_label %>';
  const AGAINST_LABEL = '<%= topic.against_label %>';
  const MAX_ROUNDS = <%= session.maxRounds %>;
</script>
<script src="/js/debate.js"></script>
